# LearnPath AI - Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Optional: Automatically falls back to In-Memory MongoDB if omitted or unreachable)
MONGO_URI=mongodb://localhost:27017/learnpath_ai

# JWT Authentication Secret
JWT_SECRET=learnpath_ai_secure_jwt_secret_key_2026

# LLM Provider Configuration (gemini | openai | local)
LLM_PROVIDER=gemini

# Google Gemini API Key (Optional: App includes intelligent deterministic fallback engines for offline demo)
GEMINI_API_KEY=
